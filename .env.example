# TeslaMate 数据库连接 (只读即可)
DATABASE_HOST=teslamate-database
DATABASE_PORT=5432
DATABASE_USER=teslamate
DATABASE_PASS=your_teslamate_db_password
DATABASE_NAME=teslamate

# TeslaMate MQTT 实时事件总线
MQTT_HOST=teslamate-mosquitto
MQTT_PORT=1883

# 高德地图 API Key (可选，若不配置自动使用内置通用解析)
AMAP_KEY=
NEXT_PUBLIC_AMAP_KEY=

# 时区配置
TZ=Asia/Shanghai

# 车辆控制 (Tesla Fleet API)，全部可选：任一为空则首页不显示控制按钮。
# 需要在 developer.tesla.cn (中国区) 注册应用，并在 docker 里跑一个 tesla-http-proxy 签名代理。
FLEET_CLIENT_ID=
FLEET_CLIENT_SECRET=
FLEET_REDIRECT_URI=
FLEET_AUTH_HOST=
FLEET_API_HOST=
FLEET_PROXY_URL=
FLEET_TOKEN_FILE=
FLEET_PUBLIC_KEY_FILE=
